{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": { "APP_VARIANT": "lan", "EXPO_PUBLIC_API_URL": "http://192.168.1.100:3000" }
    },
    "lan": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_VARIANT": "lan", "EXPO_PUBLIC_API_URL": "http://192.168.1.100:3000" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_API_URL": "https://example.com" }
    }
  },
  "submit": { "production": {} }
}
