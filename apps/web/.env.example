# 本地开发：复制为 apps/web/.env.local 后填写

NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development

# 数据库（本地可用 docker run -p 5432:5432 -e POSTGRES_PASSWORD=dev postgres:16-alpine）
DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres
# 启动时自动创建账号表
AUTO_MIGRATE=true

# 账号系统：随机 32 字节以上，例如 openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google 登录（Google Cloud Console → API 和服务 → 凭据 → OAuth 客户端 ID → Web 应用）
# 已获授权的重定向 URI：http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE 登录（LINE Developers → Provider → LINE Login channel）
# Callback URL：http://localhost:3000/api/auth/callback/line
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
