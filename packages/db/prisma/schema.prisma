// 数据库表设计，对应规划文档第 8 节。
// 出生信息（姓名、出生时间）以应用层加密后的密文存储，字段以 Enc 结尾。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String?        @unique
  locale        String         @default("th")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  identities    AuthIdentity[]
  profiles      BirthProfile[]
  entitlements  Entitlement[]
  purchases     Purchase[]
  credits       Credit[]
}

/// 多种登录方式（email / google / apple / line）绑定同一账号
model AuthIdentity {
  id          String   @id @default(cuid())
  userId      String
  provider    String
  providerUid String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUid])
  @@index([userId])
}

/// 用户保存的命主，可以保存多人（自己、家人、伴侣）
model BirthProfile {
  id          String   @id @default(cuid())
  userId      String
  nameEnc     String
  birthEnc    String   // 加密的 { year, month, day, hour, minute }
  timeZone    String
  cityId      String?
  longitude   Float
  gender      String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  charts      Chart[]

  @@index([userId])
}

/// 计算结果缓存：记录引擎版本和流派选项，保证可复现
model Chart {
  id            String       @id @default(cuid())
  profileId     String
  type          String       // bazi / thai-birthday / ziwei ...
  options       Json
  engineVersion String
  result        Json
  createdAt     DateTime     @default(now())
  profile       BirthProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reports       Report[]

  @@index([profileId, type])
}

/// 全球城市库，来源 GeoNames
model City {
  id        String @id
  nameTh    String
  nameZhs   String
  nameZht   String
  nameEn    String
  lat       Float
  lng       Float
  timeZone  String
  country   String

  @@index([country])
}

/// 权益：由 RevenueCat / Stripe Webhook 写入，后端是唯一真实来源
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  key       String    // premium
  source    String    // ios / android / stripe / promptpay
  expiresAt DateTime?
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, source])
}

/// 订单流水，用于对账和退款
model Purchase {
  id         String   @id @default(cuid())
  userId     String
  product    String
  channel    String   // ios / android / stripe / promptpay
  externalId String   @unique
  amount     Int      // 最小货币单位（萨当 / 分）
  currency   String
  status     String   // pending / paid / refunded / failed
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// 单次购买的报告额度
model Credit {
  id      String @id @default(cuid())
  userId  String
  kind    String // report / compatibility
  balance Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind])
}

/// 付费报告：生成一次后缓存
model Report {
  id        String   @id @default(cuid())
  chartId   String
  locale    String
  content   String
  aiUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
  chart     Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)

  @@unique([chartId, locale])
}

/// 运势与知识文章
model ContentPage {
  id          String    @id @default(cuid())
  slug        String
  locale      String
  type        String    // horoscope / article / lucky-color
  title       String
  body        String
  publishedAt DateTime?

  @@unique([slug, locale])
}
