# 复制为 .env 后填写。.env 不要提交到 Git，也不要发给别人。

# 正式域名（不带 https://，不带 www）。域名的 A 记录要先指向这台服务器的 IP
SITE_DOMAIN=example.com

# 要运行的镜像标签：prod（最新正式版）或某个版本号，例如 v1.0.0（用于回滚）
LUCKY_TAG=prod

# 数据库（只在服务器内部使用）
POSTGRES_USER=lucky
POSTGRES_PASSWORD=请改成随机长密码
POSTGRES_DB=lucky

# 账号系统：openssl rand -base64 32 生成，不要和内网版相同，上线后不要再改
BETTER_AUTH_SECRET=

# Google 登录：重定向 URI 填 https://你的域名/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE 登录：Callback URL 填 https://你的域名/api/auth/callback/line
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
