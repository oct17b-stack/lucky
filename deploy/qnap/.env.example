# 复制为 .env 后填写。.env 不要提交到 Git。

# 数据库（只在 NAS 内部使用）
POSTGRES_USER=lucky
POSTGRES_PASSWORD=请改成随机长密码
POSTGRES_DB=lucky_staging

# Cloudflare One（Zero Trust）→ Networking → Tunnels → 创建隧道后，docker 命令里 --token 后面的字符串
CLOUDFLARE_TUNNEL_TOKEN=

# 测试版网址，必须与 GitHub 仓库变量 STAGING_URL 相同（构建镜像时写入）
NEXT_PUBLIC_SITE_URL=https://beta.example.com

# 镜像仓库登录凭据（先 export DOCKER_CONFIG=/share/Container/lucky-staging/.docker 再 docker login ghcr.io）
# 威联通 admin 的家目录重启后会清空，所以存在这个持久文件夹里
DOCKER_CONFIG_JSON=/share/Container/lucky-staging/.docker/config.json

# 账号系统：随机 32 字节以上，生成方法：openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google 登录：重定向 URI 填 https://beta.你的域名/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE 登录：Callback URL 填 https://beta.你的域名/api/auth/callback/line
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
