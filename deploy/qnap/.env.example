# 复制为 .env 后填写。.env 不要提交到 Git。

# 数据库（只在 NAS 内部使用）
POSTGRES_USER=lucky
POSTGRES_PASSWORD=请改成随机长密码
POSTGRES_DB=lucky_staging

# Cloudflare Zero Trust → Networks → Tunnels → 创建隧道后得到的 token
CLOUDFLARE_TUNNEL_TOKEN=

# 测试版网址（也会在 GitHub Actions 构建镜像时写入）
NEXT_PUBLIC_SITE_URL=https://beta.example.com

# docker login ghcr.io 之后生成的凭据文件位置（威联通上通常是管理员家目录）
DOCKER_CONFIG_JSON=/share/homes/admin/.docker/config.json
