# 复制为 .env 后填写。.env 不要提交到 Git。

# 数据库（只在 NAS 内部使用）
POSTGRES_USER=lucky
POSTGRES_PASSWORD=请改成随机长密码
POSTGRES_DB=lucky_staging

# 内网访问地址：http://NAS的IP:3000，必须与 GitHub 仓库变量 LAN_URL 相同（构建镜像时写入）
# 建议在路由器里给 NAS 固定 IP，否则 IP 变了要重新构建
NEXT_PUBLIC_SITE_URL=http://192.168.1.100:3000

# 镜像仓库登录凭据（先 export DOCKER_CONFIG=/share/Container/lucky-staging/.docker 再 docker login ghcr.io）
# 威联通 admin 的家目录重启后会清空，所以存在这个持久文件夹里
DOCKER_CONFIG_JSON=/share/Container/lucky-staging/.docker/config.json

# 账号系统：随机 32 字节以上，生成方法：openssl rand -base64 32（不要和正式版相同）
BETTER_AUTH_SECRET=

# 内网版不填 Google/LINE 密钥，用测试账号登录即可
